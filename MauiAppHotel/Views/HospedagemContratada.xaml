<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Resumo da sua Estadia" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource Primary}" 
                   HorizontalOptions="Center"/>

            <Frame Padding="20" CornerRadius="12">
                <VerticalStackLayout Spacing="12">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Suíte Escolhida:" FontAttributes="Bold"/>
                        <Label Text="{Binding QuartoSelecionado.Descricao}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Adultos:" FontAttributes="Bold"/>
                        <Label Text="{Binding QntAdultos}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Crianças:" FontAttributes="Bold"/>
                        <Label Text="{Binding QntCriancas}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Check-in:" FontAttributes="Bold"/>
                        <Label Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Check-out:" FontAttributes="Bold"/>
                        <Label Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Estadia (dias):" FontAttributes="Bold"/>
                        <Label Text="{Binding TotalDias}"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="0,5"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Valor Total:" FontAttributes="Bold" FontSize="18"/>
                        <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    Clicked="Button_Clicked" 
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>